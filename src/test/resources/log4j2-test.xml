<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%-5level %logger{1}: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- The client tests provoke its failures on purpose. -->
        <Logger name="cz.cvut.fit.acb.ACBClient" level="off"/>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
